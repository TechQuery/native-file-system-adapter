{
  "name": "@tech_query/native-file-system-adapter",
  "version": "3.1.0",
  "description": "Native File System API",
  "source": "src/es6.js",
  "main": "dist/es6.js",
  "browser": "dist/polyfill.umd.js",
  "module": "dist/es6.js",
  "targets": {
    "types": false
  },
  "exports": {
    ".": {
      "types": "./types/src/es6.d.ts",
      "import": "./dist/es6.js"
    },
    "./polyfill": {
      "import": "./dist/polyfill.js",
      "require": "./dist/polyfill.umd.js"
    }
  },
  "directories": {
    "example": "example"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:wpt-node",
    "test:browser": "php -S localhost:4444 & open http://localhost:4444/example/test.html",
    "test:node": "node test/test-node.js",
    "test:serialize": "node test/test-serialize.js",
    "test:deno": "deno run --allow-read --allow-write --allow-net test/test-deno.js",
    "test:wpt-in-deno": "deno run --allow-read --allow-write --allow-net test/test-wpt-in-deno.js",
    "test:wpt-node": "node test/wpt-node.js",
    "test:wpt-browser": "npx playwright test",
    "test:wpt-browser:chromium": "npx playwright test --project=chromium",
    "test:wpt-browser:firefox": "npx playwright test --project=firefox",
    "test:wpt-browser:webkit": "npx playwright test --project=webkit",
    "fetch-wpt": "bash scripts/fetch-wpt.sh",
    "build": "rm -rf dist/ types/  &&  tsc -p jsconfig.json  &&  tsdown src/es6.js src/polyfill.js --format esm  &&  tsdown src/polyfill.js --format umd --no-clean",
    "prepublishOnly": "npm run build",
    "_prepublishOnly": "rm -rf types && tsc -p jsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechQuery/native-file-system-adapter.git"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "types/src/es6.d.ts",
  "keywords": [
    "filesystem",
    "file",
    "blob",
    "stream",
    "fs",
    "read",
    "write",
    "delete",
    "file system access",
    "spec"
  ],
  "author": "Jimmy Wärting",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TechQuery/native-file-system-adapter/issues"
  },
  "contributors": [
    {
      "name": "Alexandru Ciuca"
    },
    {
      "name": "TechQuery",
      "email": "shiy2008@gmail.com"
    }
  ],
  "homepage": "https://github.com/TechQuery/native-file-system-adapter#readme",
  "standard": {
    "globals": [
      "File",
      "performance",
      "Blob",
      "Response",
      "ClipboardEvent",
      "DataTransferItem",
      "FormData",
      "alert",
      "ReadableStream",
      "DataTransfer"
    ]
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/jimmywarting"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/jimmywarting"
    }
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/filesystem": "^0.0.36",
    "@types/node": "^22.20.5",
    "standard": "^17.1.2",
    "tape": "^5.10.3",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid",
    "semi": false
  }
}
